SQLSERVER_HOST=POZOSLASFUENTES
SQLSERVER_DATABASE=ARCA
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_USE_WINDOWS_AUTH=true
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_CERT=true

DB_SERVER=POZOSLASFUENTES
DB_NAME=ARCA
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=true
DB_TRUSTED_CONNECTION=true

SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=

# Fuente canonica para el dashboard energetico.
# El dashboard hidrico consulta dbo.SensorsBOS_Pozo, dbo.SensorsBOS_Tanque
# e iot.readings_minute en la base ARCA.
SQLSERVER_SOURCE_MODE=table
SQLSERVER_SOURCE_TABLE=dbo.v_dashboard_measurements

# Configuracion SMTP para envio de reportes por correo.
# Para Office365 puede requerirse SMTP AUTH habilitado o contraseña de aplicacion segun politica de la cuenta.
SMTP_HOST=mail.rsrc.com.mx
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
